# Public production URL used for canonical URLs, structured data and sitemap.
# Set this to the actual live domain before building if your domain changes.
NEXT_PUBLIC_SITE_URL=https://sk-garments-studio.sanjaybalaji-k.chatgpt.site

# Optional HTML verification token from Google Search Console (not a password).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional custom Gmail sender. Leave blank to keep the current FormSubmit flow.
# Enable only after services/quote-mailer is configured and running.
NEXT_PUBLIC_QUOTE_API_URL=
